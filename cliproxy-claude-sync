#!/usr/bin/env python3
"""Copy a Claude Code access token into a local CLIProxyAPI auth file.

Claude Code keeps ownership of token renewal. This clears the proxy refresh
token so the proxy cannot renew the sign-in. When under 45 minutes remain,
a small Claude Code call requests renewal before copying.
"""
import argparse, datetime, json, os, subprocess, sys, tempfile, time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--config', default='~/.config/agent-usage/config.json', help='JSON config path (default: %(default)s)')
args = parser.parse_args()
with open(os.path.expanduser(args.config)) as handle:
    config = json.load(handle)['sync']
SOURCE = os.path.expanduser(config['credential_path'])
TARGET = os.path.expanduser(config['target_path'])


def read():
    with open(SOURCE) as handle:
        return json.load(handle)["claudeAiOauth"]


oauth = read()
if oauth["expiresAt"] / 1000 - time.time() < 45 * 60:
    subprocess.run(
        ["claude", "-p", "ok", "--model", "claude-haiku-4-5-20251001"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=120, check=False, cwd=tempfile.gettempdir(),
    )
    oauth = read()

with open(TARGET) as handle:
    current = json.load(handle)
if current.get("access_token") == oauth["accessToken"]:
    sys.exit(0)

zone = datetime.datetime.now().astimezone().tzinfo
stamp = lambda seconds: datetime.datetime.fromtimestamp(seconds, zone).isoformat(timespec="seconds")
current.update(
    access_token=oauth["accessToken"], refresh_token="",
    expired=stamp(oauth["expiresAt"] / 1000), last_refresh=stamp(time.time()), disabled=False,
)
handle = tempfile.NamedTemporaryFile("w", dir=os.path.dirname(TARGET), delete=False)
json.dump(current, handle)
handle.close()
os.chmod(handle.name, 0o600)
os.replace(handle.name, TARGET)
print("claude token copied, valid until", current["expired"])
